# Copie de ce fichier vers .env, puis renseigner les valeurs marquées.
# Voir aussi ../.env — les variables partagées doivent rester synchronisées.

DATABASE_URL=<a-renseigner>
REDIS_URL=<a-renseigner>
SEED_SUPERADMIN_EMAIL=admin@test.com
SEED_SUPERADMIN_PASSWORD=<a-renseigner>
TOTP_ENC_KEY=<a-renseigner>
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://192.168.217.135:5173
FRONTEND_URL=http://192.168.217.135:5173
EMAIL_TRANSPORT=console
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=<a-renseigner>
SMTP_FROM="Talixman Range <onboarding@resend.dev>"
LABS_ORCHESTRATOR_PORT=4100
LABS_ORCHESTRATOR_URL=http://localhost:4100
ORCHESTRATOR_SERVICE_TOKEN=<a-renseigner>

# Clé maîtresse du lancement authentifié des composants de labo.
# Le secret réel de chaque labo en est DÉRIVÉ (HMAC + labId) : cette clé ne
# quitte jamais le portail et l'orchestrateur. Générer avec : openssl rand -hex 32
LAB_SSO_MASTER_KEY=<a-renseigner>
