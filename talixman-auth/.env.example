# --- PostgreSQL ---
POSTGRES_USER=talixman
POSTGRES_PASSWORD=changeme
POSTGRES_DB=talixman_auth
POSTGRES_PORT=5432
DATABASE_URL=postgresql://talixman:changeme@localhost:5432/talixman_auth

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=3000
NODE_ENV=development
# Origine(s) autorisée(s) pour le CORS, séparées par des virgules
CORS_ORIGIN=http://localhost:5173

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000
# URL publique du frontend, utilisée par le backend pour construire les liens d'activation par email
FRONTEND_URL=http://localhost:5173
# Port exposé par le conteneur Nginx en prod (docker-compose.prod.yml)
FRONTEND_HTTP_PORT=8080

# --- Sécurité TOTP ---
# Clé de chiffrement AES-256-GCM (32 octets) pour le secret TOTP au repos.
# Générer avec: openssl rand -hex 32
TOTP_ENC_KEY=changeme

# --- Compte SUPERADMIN initial (seed) ---
SEED_SUPERADMIN_EMAIL=admin@test.com
SEED_SUPERADMIN_PASSWORD=changeme

# --- Email transactionnel (SMTP) ---
# En dev, laisser EMAIL_TRANSPORT=console pour logger les emails au lieu de les envoyer.
#
# Fournisseur recommandé : Resend (smtp.resend.com) — conçu pour l'email transactionnel
# applicatif (auth, invitations, OTP), délivrabilité optimisée pour ce volume/usage, pas de
# changement de code requis (EmailService parle déjà SMTP générique via Nodemailer).
#   EMAIL_TRANSPORT=smtp
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASSWORD=<clé API Resend, préfixée re_>
#   SMTP_FROM="Talixman Range <no-reply@talixmangroup.com>"
#
# Tant que le domaine d'envoi (ici talixmangroup.com) n'est pas vérifié dans Resend
# (resend.com/domains, enregistrements DNS SPF/DKIM), le mode sandbox impose :
#   - SMTP_FROM="Talixman Range <onboarding@resend.dev>"
#   - délivrance possible UNIQUEMENT vers l'adresse email du compte Resend lui-même —
#     le nom affiché n'a aucune influence sur cette restriction, seul le domaine vérifié compte.
#
# Alternative : Brevo (ex-Sendinblue, acteur UE — à considérer si une contrainte de résidence
# des données en Europe apparaît) :
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=<identifiant SMTP Brevo>
#   SMTP_PASSWORD=<clé SMTP Brevo>
EMAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=admin@test.com

# --- Cyber Range Orchestrator (middleware Docker Compose — le portail ne parle jamais
# directement à Docker, cf. cyber-range-orchestrator/) ---
# LABS_ORCHESTRATOR_URL : http://localhost:4100 pour les outils lancés depuis l'hôte, mais
# http://host.docker.internal:4100 (override dans docker-compose.yml → services.api.environment)
# pour le conteneur api — l'orchestrateur est un projet Docker Compose séparé (son propre
# docker-compose.yml), donc hors du réseau bridge de ce compose, même piège que DATABASE_URL
# mais dans l'autre sens (ici c'est nous qui sortons du bridge, pas le service cible qui y entre).
LABS_ORCHESTRATOR_PORT=4100
LABS_ORCHESTRATOR_URL=http://localhost:4100
# Secret partagé avec cyber-range-orchestrator/.env (même valeur des deux côtés) — seule
# authentification de cette API interne, jamais exposée publiquement.
ORCHESTRATOR_SERVICE_TOKEN=change-me-in-dev

# --- Lancement authentifié des composants de labo ---
# Le secret de chaque labo est DÉRIVÉ de cette clé (HMAC + identifiant du labo) :
# elle ne quitte jamais le portail et l'orchestrateur, et un labo compromis ne
# permet pas de remonter jusqu'à elle. Doit être IDENTIQUE côté orchestrateur.
# Générer : openssl rand -hex 32
LAB_SSO_MASTER_KEY=
