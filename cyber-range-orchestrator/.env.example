# --- Cyber Range Orchestrator (runtime Docker-in-Docker) ---

# Port HTTP publié par le rôle `gateway` (le backend talixman-auth atteint le
# rôle `control` par le réseau interne, sans port publié — cf. docker-compose.yml).
PORT=4100

# Secret partagé avec talixman-auth/backend (ORCHESTRATOR_SERVICE_TOKEN côté
# portail) — authentifie l'API de contrôle (/labs/*, /templates/*).
# Le rôle `gateway` ne l'utilise jamais : la route /apps/* (proxy HTTP/WS vers
# les labos) est volontairement publique, un navigateur ne pouvant pas
# présenter ce token (cf. gateway/lab-gateway.ts).
ORCHESTRATOR_SERVICE_TOKEN=change-me-in-dev

# --- Runtime des labos -------------------------------------------------------

# Runtime concret : `dind` (défaut, v1) ou `kata` (cible long terme, exige KVM
# sur l'hôte + le runtime Kata enregistré). Le middleware ne dépend jamais
# directement de l'un ou de l'autre : cf. LabRuntimeDriver / LAB_RUNTIME_DRIVER.
LAB_RUNTIME=dind

# Réseau Docker dédié aux labos, créé par ce docker-compose.yml en `internal`.
# AUCUN service du portail ne doit y être attaché : c'est ce qui empêche un
# labo de joindre Postgres/Redis/Keycloak.
LABS_NETWORK=talixman_labs

# Répertoire de données du démon interne d'un labo, couvert par un volume dédié
# (sans lui, le démon retombe sur le driver de stockage `vfs`, lent et gourmand).
#   image rootless : /home/rootless/.local/share/docker
#   image root     : /var/lib/docker
LAB_DATA_DIR=/home/rootless/.local/share/docker

# `--privileged` sur le conteneur du labo. Reste nécessaire au démon interne
# (montages, cgroups) même avec l'image rootless — où il est toutefois bien
# moins grave, les privilèges s'exerçant dans le user namespace d'un
# utilisateur non privilégié. `false` tente un confinement plus strict
# (seccomp/apparmor unconfined + /dev/fuse), à valider labo par labo.
LAB_PRIVILEGED=true

# Quotas par labo — un labo ne doit jamais pouvoir épuiser l'hôte.
LAB_MEMORY=6g
LAB_CPUS=4
LAB_PIDS_LIMIT=4096

# Journalisation bornée du conteneur de labo (sinon les logs du démon interne
# grossissent sans limite).
LAB_LOG_MAX_SIZE=10m
LAB_LOG_MAX_FILE=3

# --- Nettoyage automatique des labos inactifs --------------------------------
# Le compteur d'inactivité est `lastSeenAt`, rafraîchi à chaque consultation de
# l'état par le portail : un labo affiché à l'écran n'est jamais fauché.
# Balayage toutes les 5 min, uniquement dans le rôle `control`.
LAB_REAPER_ENABLED=true
# Arrêt (récupérable en un clic) après N minutes sans consultation.
LAB_IDLE_STOP_MINUTES=60
# Destruction (libère le disque) après N heures sans consultation.
LAB_IDLE_DESTROY_HOURS=24

# --- Templates et état -------------------------------------------------------

# Dossier HÔTE contenant les templates (un sous-dossier par template, ex.
# dispatching/, chacun avec lab-template.json + lab-components.json). Monté en
# lecture seule à TEMPLATES_DIR dans le conteneur (cf. docker-compose.yml).
# L'orchestrateur ne fait que LIRE ces métadonnées : l'image de labo embarque
# elle-même le compose et les images du laboratoire.
TEMPLATES_HOST_DIR=/chemin/absolu/vers/auth_plateforme

# Chemin des templates VU DEPUIS LE CONTENEUR (cible du montage ci-dessus).
TEMPLATES_DIR=/templates

# Fichier d'état du middleware (volume persistant) — labId -> {template,
# createdAt}. Écrit par le rôle `control`, lu en lecture seule par `gateway`.
LABS_STATE_FILE=/data/labs.json

# --- Exposition publique des composants de labo ------------------------------
# Stratégie v1 : UNE ORIGINE PAR COMPOSANT, chacune sur son port.
# Raison : les applications du labo (FUXA, OpenPLC, viewer 3D) construisent
# toutes leurs URLs à la racine (`<base href="/">`, `Location: /login`, appels
# `/api/...`). Les servir sous un préfixe de chemin est impossible sans les
# modifier — ce qu'on s'interdit. Cf. ingress/lab-ingress.ts.
#
# Le portail ne connaît JAMAIS ces ports : il lit `services[].url` renvoyé par
# l'API. Passer plus tard à un routage par nom d'hôte (reverse-proxy TLS +
# domaine) ne changera donc rien côté portail ni côté labo.

# Hôte par lequel le NAVIGATEUR de l'utilisateur joint cette machine — jamais
# `localhost`, qui désignerait le poste client. IP ou nom de domaine.
GATEWAY_PUBLIC_HOST=192.168.217.135

# Plage de ports allouée aux composants. Doit correspondre à la plage publiée
# par le service `gateway` (cf. docker-compose.yml). Compter un port par
# composant et par labo (11 composants dans le template dispatching).
LAB_INGRESS_PORT_MIN=20000
LAB_INGRESS_PORT_MAX=20099

# Fréquence de synchronisation des points d'entrée de la gateway avec l'état
# des labos (ouverture/fermeture au fil des créations et suppressions).
GATEWAY_SYNC_INTERVAL_MS=5000

# Lancement authentifié des composants — doit être IDENTIQUE côté portail.
# Générer : openssl rand -hex 32
LAB_SSO_MASTER_KEY=
