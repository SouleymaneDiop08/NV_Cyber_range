# ============================================================
# TER MAP — Environment Variables
# Copier en .env et adapter à votre environnement
# ============================================================

# ── Backend server ──────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── PLC Station B (Modbus TCP) ─────────────────────────────
PLC_B_HOST=192.168.20.10
PLC_B_PORT=502
PLC_B_UNIT_ID=1

# ── Polling & timeouts ─────────────────────────────────────
# Intervalle de polling Modbus en millisecondes
POLL_INTERVAL_MS=500
# Délai après lequel une donnée est considérée "stale" (ms)
STALE_TIMEOUT_MS=3000
# Délai après lequel le PLC est considéré "offline" (ms)
OFFLINE_TIMEOUT_MS=10000
# Timeout connexion Modbus TCP (ms)
MODBUS_CONNECT_TIMEOUT_MS=5000
# Délai de reconnexion automatique (ms)
MODBUS_RECONNECT_DELAY_MS=2000

# ── CORS ───────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Limites plausibles (validation) ───────────────────────
MAX_SPEED_KMH=160
MAX_TRACTION_CURRENT_A=1200
MAX_TRANSFO_TEMP_C=150
MAX_CATENARY_VOLTAGE_V=30000

# ── Frontend (Vite) ────────────────────────────────────────
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000
VITE_POLL_DISPLAY_MS=500
